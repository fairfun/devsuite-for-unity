@import "../Common.uss";

:root,
.panel-root {
    --counter-bg-color: rgba(42, 42, 42, 0.7);
    --text-value-color: rgb(225, 183, 116);
    --graph-color-good: rgb(121, 175, 85);
    --graph-color-bad: rgb(202, 65, 60);
    --reference-line-color: rgba(202, 65, 60, 0.6);
}

.panel-root {
    padding: 8px;
    flex-direction: column;
    min-width: 250px;
    align-self: stretch;
}


.graph-view {
    height: 56px;
    width: 100%;
    margin-bottom: 4px;
    flex-direction: row;
    align-items: flex-end;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    overflow: hidden;
}

.graph-view--last {
    margin-bottom: 0;
}

.graph-bar {
    background-color: var(--graph-color-good);
}

.reference-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--reference-line-color);
}

.ff-performance-graph-info {
    position: absolute;
    top: 3px;
    left: 3px;
    margin: 0;
    -unity-text-align: upper-left;
    color: var(--text-color);
    font-size: 10px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 1px 4px;
    border-radius: 3px;
}

.graph-view--collapsed {
    height: 22px;
    min-height: 22px;
    align-items: center;
}

.graph-view--collapsed .ff-performance-graph-info {
    position: relative;
    top: auto;
    bottom: auto;
    left: auto;
    margin: 0;
    padding: 0 4px 0 5px;
    background-color: transparent;
    -unity-text-align: middle-left;
}

.ff-performance-graph-pin-btn {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 18px;
    height: 18px;
    -unity-font-definition: resource('Lucide SDF');
    -unity-text-generator: standard;
    font-size: 11px;
    color: var(--text-color);
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 0;
    border-radius: 3px;
    padding: 0;
    margin: 0;
    opacity: 0.6;
    cursor: arrow;
    -unity-text-align: middle-center;
}

.ff-performance-graph-pin-btn:hover {
    opacity: 1;
    color: var(--text-color);
    background-color: rgba(0, 0, 0, 0.85);
}

.ff-performance-graph-pin-btn:active {
    scale: 0.88;
}

.ff-performance-graph-pin-btn.pinned {
    opacity: 1;
    color: var(--text-color);
}

.graph-view--collapsed .ff-performance-graph-pin-btn {
    top: 2px;
    right: 3px;
}

.pinned-performance-container {
    position: absolute;
    flex-direction: column;
}

.pinned-performance-container .graph-view {
    width: 260px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.pinned-performance-container .ff-performance-graph-info {
    background-color: rgba(0, 0, 0, 0.4);
}

.pinned-performance-container .ff-performance-graph-pin-btn {
    display: none;
}