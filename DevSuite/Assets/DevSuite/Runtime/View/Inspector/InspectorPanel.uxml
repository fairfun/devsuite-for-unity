<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="inspector-panel-root" class="inspector-panel-container">
        <!-- Top Toolbar / Header Row -->
        <ui:VisualElement class="inspector-toolbar">
            <ui:Button name="refreshBtn" class="inspector-btn inspector-icon-btn" tooltip="Refresh inspected object values"/>
            <ui:Button name="autoRefreshBtn" text="Auto" class="inspector-btn inspector-text-btn inspector-auto-btn" tooltip="Auto-refresh: continuously update inspected values every frame"/>
            <ui:Button name="autoPauseBtn" text="Auto Pause" class="inspector-btn inspector-text-btn inspector-auto-pause-btn" tooltip="Auto-pause: pause game when an object is selected"/>
            <ui:Button name="unselectAllBtn" text="Unselect All" class="inspector-btn inspector-text-btn inspector-unselect-all-btn" tooltip="Unselect all selected GameObjects to resume playing"/>
            <ui:VisualElement style="flex-grow: 1;"/>
            <ui:Button name="copyBtn" class="inspector-btn inspector-icon-btn" tooltip="Copy inspected components and property values to clipboard"/>
        </ui:VisualElement>

        <!-- Title and top info -->
        <ui:VisualElement class="inspector-header-row">
            <ui:VisualElement class="inspector-header-text-container">
                <ui:Label name="selectedObjectLabel" text="None selected" class="inspector-selected-object"/>
                <ui:Label name="selectedObjectPathLabel" text="" class="inspector-selected-object-path"/>
            </ui:VisualElement>
            <ui:Toggle name="goActivityToggle" class="ff-toggle inspector-go-activity-toggle" tooltip="Toggle active state" style="display: none;"/>
        </ui:VisualElement>

        <!-- Scrollable Property List -->
        <ui:ScrollView name="inspectorScrollView" class="inspector-list-view"/>
    </ui:VisualElement>
</ui:UXML>
