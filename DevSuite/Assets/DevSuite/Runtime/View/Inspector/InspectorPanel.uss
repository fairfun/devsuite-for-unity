@import "../Common.uss";

:root {
    --text-color: rgb(210, 210, 210);
    --divider-color: rgba(51, 51, 51, 0.8);
    --item-hover-bg: rgba(255, 255, 255, 0.02);
}

.inspector-panel-container {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    color: var(--text-color);
    font-size: 12px;
    border-radius: var(--panel-border-radius);
}

.inspector-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    background-color: var(--toolbar-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--divider-color);
}

.inspector-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    background-color: rgba(36, 36, 36, 0.4);
    border-bottom-width: 1px;
    border-bottom-color: var(--divider-color);
}

.inspector-header-text-container {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 4px;
}

.inspector-selected-object {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--accent-color);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.inspector-selected-object-path {
    font-size: 10px;
    color: var(--text-label-color);
    -unity-font-style: italic;
    margin-top: 2px;
    white-space: normal;
    text-overflow: ellipsis;
    overflow: hidden;
    max-height: 28px;
}

.inspector-list-view {
    flex-grow: 1;
    min-height: 0px;
}

.inspector-list-view .unity-scroll-view__content-container {
    justify-content: flex-start;
    width: 100%;
    padding: 2px;
}

/* Component Container Styling */
.inspector-component-box {
    margin-bottom: 4px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.03);
    overflow: hidden;
}

.inspector-component-header {
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
    min-height: 20px;
    background-color: rgba(255, 255, 255, 0.04);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
}

.inspector-component-name {
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
    font-size: 12px;
}

.inspector-component-type {
    font-size: 9px;
    color: var(--text-label-color);
    margin-left: 6px;
}

.inspector-component-body {
    padding: 0;
}

/* Property Rows */
.inspector-property-row {
    flex-direction: row;
    padding: 1px 6px;
    align-items: flex-start;
    min-height: 17px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.01);
}

.inspector-property-row:hover {
    background-color: var(--item-hover-bg);
}

.inspector-property-name {
    width: 45%;
    color: rgb(180, 180, 180);
    font-size: 11px;
    padding-right: 4px;
    margin: 0;
    overflow: hidden;
}

.inspector-property-value {
    width: 55%;
    color: rgb(240, 240, 240);
    font-size: 11px;
    margin: 0;
    overflow: hidden;
}

.inspector-property-row.serializable .inspector-property-name {
    color: rgb(210, 210, 210);
    -unity-font-style: bold;
}

.inspector-property-row.non-serializable .inspector-property-name {
    color: rgb(140, 140, 140);
    -unity-font-style: italic;
}

.inspector-btn,
.inspector-icon-btn,
.inspector-text-btn {
    height: 24px;
    margin-left: 2px;
    padding: 0;
    color: var(--text-label-color);
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    border-radius: 4px;
}

.inspector-btn:hover,
.inspector-icon-btn:hover,
.inspector-text-btn:hover {
    color: var(--text-color);
    background-color: rgba(255, 255, 255, 0.03);
}

.inspector-btn.active,
.inspector-icon-btn.active,
.inspector-text-btn.active {
    color: var(--text-color);
    background-color: rgba(255, 255, 255, 0.08);
}

.inspector-icon-btn {
    -unity-font-definition: resource('Font Awesome 7 Free-Solid-900 SDF');
    -unity-text-generator: standard;
    font-size: 14px;
    width: 28px;
}

.inspector-text-btn {
    font-size: 11px;
    padding-left: 6px;
    padding-right: 6px;
    -unity-text-align: middle-center;
}

.inspector-auto-btn {
    margin-left: 0px;
}

.inspector-auto-pause-btn {
    margin-left: 11px;
}

.inspector-unselect-all-btn {
    margin-left: 11px;
}

.inspector-unselect-all-btn.has-selection {
    -unity-font-style: bold;
    color: rgb(255, 204, 0);
}

.inspector-unselect-all-btn.has-selection:hover {
    color: rgb(255, 220, 50);
}

.inspector-go-header {
    background-color: rgba(60, 60, 60, 0.85);
    border-bottom-width: 0;
    padding: 3px 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
}

.inspector-go-header-text {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 4px;
}

.inspector-go-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--accent-color);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.inspector-go-path {
    font-size: 9px;
    color: var(--text-label-color);
    -unity-font-style: italic;
    margin-top: 0;
    white-space: normal;
    text-overflow: ellipsis;
    overflow: hidden;
    max-height: 26px;
}

/* Positional override — base style comes from Common.uss .ff-toggle */
.inspector-mono-toggle {
    margin-left: auto;
}

/* Positional override — base style comes from Common.uss .ff-toggle */
.inspector-go-activity-toggle {
    margin-left: auto;
    align-self: center;
}

.inspector-component-box.disabled .inspector-component-name,
.inspector-component-box.disabled .inspector-component-type {
    opacity: 0.35;
}

/* GameObject inactive dimming — single selection header label */
.inspector-selected-object.inactive {
    opacity: 0.4;
}

/* GameObject inactive dimming — multi-selection per-go header */
.inspector-go-header.inactive .inspector-go-name,
.inspector-go-header.inactive .inspector-go-path {
    opacity: 0.4;
}
