@import "../Common.uss";

:root,
.logs-panel-container {
    --divider-color: rgba(51, 51, 51, 0.8);
    --item-hover-bg: rgba(255, 255, 255, 0.03);
}

.logs-panel-container {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    color: var(--text-color);
    font-size: 12px;
    border-radius: var(--panel-border-radius);
}

.logs-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    background-color: var(--toolbar-bg);
    border-bottom-width: 0px;
    border-bottom-color: var(--border-color);
}

.logs-filter-container {
    flex-direction: row;
    align-items: center;
    background-color: rgba(36, 36, 36, 0.6);
    border-radius: 4px;
    padding: 4px 5px;
    margin: 2px 0;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    flex-grow: 1;
}

.logs-filter-icon {
    -unity-font-definition: resource('Font Awesome 7 Free-Solid-900 SDF');
    -unity-text-generator: standard;
    color: var(--text-label-color);
    font-size: 10px;
    padding: 0;
    margin: 0;
    margin-right: 2px;
}

.logs-filter-field {
    flex-grow: 1;
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    height: 16px;
    --unity-cursor-color: rgb(180, 180, 180);
}

.logs-filter-field .unity-base-text-field__input {
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 12px;
}


.logs-regex-btn {
    margin-right: 8px;
}

.logs-severity-btn {
    margin-left: 2px;
    padding: 0 8px;
    height: 24px;
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    border-radius: 4px;
    color: rgb(136, 136, 136);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 13px;
}

.logs-severity-btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.ff-panel .logs-severity-btn,
.ff-panel .logs-severity-btn Label,
.ff-panel .logs-severity-btn .unity-label,
.logs-severity-btn,
.logs-severity-btn Label,
.logs-severity-btn .logs-severity-icon,
.logs-severity-btn .logs-severity-count {
    color: rgb(136, 136, 136);
}

.logs-severity-btn.active {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
}

.logs-severity-btn.active:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.ff-panel .logs-regex-btn.active,
.ff-panel .logs-regex-btn.active Label,
.ff-panel .logs-regex-btn.active .unity-label,
.logs-regex-btn.active,
.logs-regex-btn.active Label {
    color: rgb(255, 255, 255);
}

.logs-severity-icon {
    -unity-font-definition: resource('Font Awesome 7 Free-Solid-900 SDF');
    -unity-text-generator: standard;
    font-size: 12px;
    margin: 0;
    margin-top: 1px;
    margin-right: 4px;
    padding: 0;
    -unity-text-align: middle-center;
}

.logs-severity-count {
    font-size: 12px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
}

.ff-panel .logs-severity-btn.ordinary.active,
.ff-panel .logs-severity-btn.ordinary.active Label,
.ff-panel .logs-severity-btn.ordinary.active .unity-label,
.logs-severity-btn.ordinary.active,
.logs-severity-btn.ordinary.active Label,
.logs-severity-btn.ordinary.active .logs-severity-icon,
.logs-severity-btn.ordinary.active .logs-severity-count {
    color: rgb(128, 200, 255) !important;
}

.ff-panel .logs-severity-btn.warning.active,
.ff-panel .logs-severity-btn.warning.active Label,
.ff-panel .logs-severity-btn.warning.active .unity-label,
.logs-severity-btn.warning.active,
.logs-severity-btn.warning.active Label,
.logs-severity-btn.warning.active .logs-severity-icon,
.logs-severity-btn.warning.active .logs-severity-count {
    color: rgb(255, 200, 0) !important;
}

.ff-panel .logs-severity-btn.error.active,
.ff-panel .logs-severity-btn.error.active Label,
.ff-panel .logs-severity-btn.error.active .unity-label,
.logs-severity-btn.error.active,
.logs-severity-btn.error.active Label,
.logs-severity-btn.error.active .logs-severity-icon,
.logs-severity-btn.error.active .logs-severity-count {
    color: rgb(255, 100, 100) !important;
}

.logs-icon-btn {
    -unity-font-definition: resource('Font Awesome 7 Free-Solid-900 SDF');
    -unity-text-generator: standard;
    font-size: 14px;
    width: 28px;
    height: 24px;
    margin-left: 2px;
    padding: 0;
    color: var(--text-label-color);
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    border-radius: 4px;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
}

.logs-icon-btn:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.1);
}

.clear-btn {
    margin-right: 2px;
}

.logs-list-view {
    flex-grow: 1;
    min-height: 0px;
}

.logs-list-view .unity-scroll-view__content-container {
    justify-content: flex-start;
    width: 100%;
}

.log-item-container {
    flex-direction: column;
    padding: 0;
    padding-right: 2px;
    padding-left: 1px;
    border-bottom-width: 0px;
    border-bottom-color: var(--divider-color);
    transition-duration: 0.1s;
}

.log-item-container.last-item {
    padding-bottom: 2px;
}

.log-item-container.hover-active {
    background-color: var(--item-hover-bg);
}

.log-item-header {
    flex-direction: row;
    align-items: flex-start;
}

.log-item-message {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    padding: 0;
    margin: 0;
    margin-top: 4px;
    margin-right: 2px;
}

.ff-panel .log-item-time,
.log-item-time {
    color: rgb(136, 136, 136) !important;
    margin: 0px;
    padding: 0px;
    margin-right: 4px;
    margin-top: 4px;
    flex-shrink: 0;
}

.log-item-copy-btn {
    -unity-font-definition: resource('Font Awesome 7 Free-Solid-900 SDF');
    -unity-text-generator: standard;
    width: 22px;
    height: 22px;
    padding: 0;
    font-size: 12px;
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    color: var(--text-label-color);
    margin: 0px;
}

.log-item-copy-btn:hover {
    color: rgb(255, 255, 255);
}

.ff-panel .log-item-callstack,
.log-item-callstack {
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
    color: rgb(136, 136, 136) !important;
    margin-top: 0px;
    margin-left: 4px;
    margin-bottom: 4px;
    font-size: 11px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 10px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.05);
}

/* Scrollbar styles removed, using Common.uss */

/* CLI Command Input */
.logs-cli-container {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    background-color: var(--toolbar-bg);
    border-top-width: 1px;
    border-top-color: var(--divider-color);
    position: relative;
}

.logs-cli-input-wrapper {
    flex-direction: row;
    align-items: center;
    background-color: rgba(36, 36, 36, 0.6);
    border-radius: 4px;
    padding: 4px 5px;
    margin: 2px 0;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    flex-grow: 1;
}

.logs-cli-icon {
    color: var(--text-label-color);
    font-size: 12px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
    margin-right: 4px;
}

.logs-cli-field-container {
    flex-grow: 1;
    position: relative;
    height: 16px;
    justify-content: center;
}

.logs-cli-field {
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    height: 16px;
    --unity-cursor-color: rgb(180, 180, 180);
}

.logs-cli-ghost-field {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.logs-cli-ghost-field .unity-base-text-field__input {
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    color: rgba(255, 255, 255, 0.28);
    font-size: 12px;
}

.logs-cli-foreground-field {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.logs-cli-foreground-field .unity-base-text-field__input {
    background-color: rgba(40, 40, 40, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.logs-cli-send-btn {
    height: 24px;
    padding: 0 10px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    color: var(--text-color);
    font-size: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-left: 2px;
}

.logs-cli-send-btn:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(255, 255, 255);
}

/* CLI Suggestions Tooltip */
.logs-cli-tooltip {
    position: absolute;
    bottom: 34px;
    left: 6px;
    right: 6px;
    background-color: rgba(30, 30, 30, 0.96);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 2px;
    max-height: 272px;
    overflow: hidden;
}

.logs-cli-tooltip-top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    margin-bottom: 2px;
}

.logs-cli-tooltip-top-header-title {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.logs-cli-tooltip-top-header-hint {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
    padding: 0;
}

.logs-cli-tooltip-scroll {
    max-height: 246px;
}

.logs-cli-tooltip-item {
    flex-direction: column;
    padding: 2px 5px;
    border-radius: 3px;
    margin-bottom: 1px;
}

.logs-cli-tooltip-item.highlighted {
    background-color: rgba(255, 255, 255, 0.032);
}

.logs-cli-tooltip-item:hover,
.logs-cli-tooltip-item.highlighted:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.logs-cli-tooltip-item.selected {
    background-color: rgba(255, 255, 255, 0.12);
}

.logs-cli-tooltip-header {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin: 1px;
    margin-left: 0;
    padding: 1px;
    padding-left: 0;
}

.ff-panel .logs-cli-tooltip-path,
.logs-cli-tooltip-item .logs-cli-tooltip-path,
.logs-cli-tooltip-path {
    color: rgba(255, 255, 255, 0.32) !important;
    font-size: 11px;
    margin: 1px;
    margin-left: 0;
    padding: 1px;
    padding-left: 0;
    margin-right: 0px;
}

.ff-panel .logs-cli-tooltip-cmd,
.logs-cli-tooltip-item .logs-cli-tooltip-cmd,
.logs-cli-tooltip-cmd {
    color: var(--text-color) !important;
    font-size: 11px;
    margin: 1px;
    margin-left: 0;
    margin-right: 4px;
    padding: 1px;
    padding-left: 0;
    -unity-font-style: bold;
}

.ff-panel .logs-cli-tooltip-params,
.logs-cli-tooltip-item .logs-cli-tooltip-params,
.logs-cli-tooltip-params {
    color: rgb(180, 180, 180) !important;
    font-size: 10px;
    margin: 1px;
    padding: 1px;
}

.ff-panel .logs-cli-tooltip-desc,
.logs-cli-tooltip-item .logs-cli-tooltip-desc,
.logs-cli-tooltip-desc {
    color: rgb(136, 136, 136) !important;
    font-size: 9.5px;
    margin: 1px;
    margin-left: 0;
    margin-top: 0px;
    padding: 1px;
    padding-left: 0;
    white-space: normal;
}