<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" display-tooltip-when-elided="true" editor-extension-mode="False">
    <ui:VisualElement name="ff-control-panel-root" class="ff-control-panel-root">
        <ui:Button name="reset-btn" text="" class="ff-control-panel-btn" tooltip="Reset DevSuite settings.&#10;&#10;Clears persisted panel states, pinned commands, collapsed graphs, and search filters in &lt;b&gt;&lt;color=#ffc800&gt;ISavedPrefs&lt;/color&gt;&lt;/b&gt;.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Assign &lt;b&gt;&lt;color=#ffc800&gt;SavedPrefs.Factory&lt;/color&gt;&lt;/b&gt; for a custom implementation of &lt;b&gt;&lt;color=#ffc800&gt;ISavedPrefs&lt;/color&gt;&lt;/b&gt;."/>
        <ui:VisualElement name="divider" class="ff-control-panel-divider"/>
        <ui:VisualElement name="spacer" class="ff-control-panel-spacer">
            <ui:Label name="version-lbl" class="ff-control-panel-version" tooltip="Application build version (default: &quot;v&quot; + Application.version).&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Modify it via &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.BuildVersionToDisplay&lt;/color&gt;&lt;/b&gt;."/>
        </ui:VisualElement>
        <ui:Button name="logs-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Logs &amp; CLI panel (Shortcut: Ctrl + `).&#10;&#10;View console output, filter by severity or regex, and execute debug commands."/>
        <ui:Button name="hierarchy-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Hierarchy panel.&#10;&#10;Explore scene objects, two-way sync with Unity Editor Selection, pick objects in Game View, and search by name or component type."/>
        <ui:Button name="inspector-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Inspector panel.&#10;&#10;Inspect runtime fields and properties of selected GameObjects, toggle component states, and auto-pause gameplay on selection."/>
        <ui:Button name="metrics-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Performance panel.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Check &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.RegisterPerformancePanelGraph&lt;/color&gt;&lt;/b&gt; and &lt;b&gt;&lt;color=#ffc800&gt;SetPerformanceGraphSettings&lt;/color&gt;&lt;/b&gt;.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Inherit &lt;b&gt;&lt;color=#ffc800&gt;BaseGraphDataProvider&lt;/color&gt;&lt;/b&gt; to implement your own custom graphs."/>
        <ui:Button name="commands-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Commands panel.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Check the &lt;b&gt;&lt;color=#ffc800&gt;CommonCommands&lt;/color&gt;&lt;/b&gt; class implementation for hints on how to use the Attributes and API.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Check &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.AttributesParser&lt;/color&gt;&lt;/b&gt; and &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.CommandsApi&lt;/color&gt;&lt;/b&gt; for advanced control."/>
        <ui:Button name="pinned-commands-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Pinned Commands panel.&#10;&#10;Quick-access bar for frequently used commands. Pin commands via the pin icon in the Commands panel.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Mark methods with &lt;b&gt;&lt;color=#ffc800&gt;[Command(AlwaysPin = true)]&lt;/color&gt;&lt;/b&gt; in code to pin permanently."/>
        <ui:Button name="expand-btn" text="" class="ff-control-panel-btn" tooltip="Expand/Collapse DevSuite.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Configure button settings (Activation Mode, Expand Button Visibility) in the &lt;b&gt;&lt;color=#ffc800&gt;DevSuitePanel&lt;/color&gt;&lt;/b&gt; prefab Settings.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;To disable the panel, define the scripting symbol &lt;b&gt;&lt;color=#ffc800&gt;DEVSUITE_DISABLED&lt;/color&gt;&lt;/b&gt;, or set &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Enabled = false&lt;/color&gt;&lt;/b&gt; before &lt;b&gt;&lt;color=#ffc800&gt;DevSuitePanelUI.Awake&lt;/color&gt;&lt;/b&gt; (order -99)."/>
    </ui:VisualElement>
</ui:UXML>
