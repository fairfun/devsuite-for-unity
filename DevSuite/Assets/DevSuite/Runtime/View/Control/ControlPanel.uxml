<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" display-tooltip-when-elided="true" editor-extension-mode="False">
    <ui:VisualElement name="ff-control-panel-root" class="ff-control-panel-root">
        <ui:Button name="reset-btn" text="" class="ff-control-panel-btn" tooltip="Reset DevSuite settings.&#10;&#10;Clears persisted panel states, pinned commands, collapsed graphs, and search filters in &lt;b&gt;&lt;color=#ffc800&gt;ISavedPrefs&lt;/color&gt;&lt;/b&gt;.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Hold the reset button for &lt;b&gt;&lt;color=#ff6666&gt;2 seconds&lt;/color&gt;&lt;/b&gt; to clear all &lt;b&gt;&lt;color=#ffc800&gt;SavedPrefs&lt;/color&gt;&lt;/b&gt;.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Assign &lt;b&gt;&lt;color=#ffc800&gt;SavedPrefs.Factory&lt;/color&gt;&lt;/b&gt; for a custom implementation of &lt;b&gt;&lt;color=#ffc800&gt;ISavedPrefs&lt;/color&gt;&lt;/b&gt;."/>
        <ui:VisualElement name="divider" class="ff-control-panel-divider"/>
        <ui:VisualElement name="spacer" class="ff-control-panel-spacer">
            <ui:Label name="version-lbl" class="ff-control-panel-version" tooltip="Application build version (default: &quot;v&quot; + Application.version + optional bundle number in parentheses).&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Modify it via &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.BuildVersionToDisplay&lt;/color&gt;&lt;/b&gt;."/>
            <ui:Button name="unpause-btn" text="Unpause" class="ff-control-panel-unpause-btn" tooltip="Game is paused.&#10;&#10;Click to reset pause ValueStack and resume gameplay at 1.0 speed."/>
        </ui:VisualElement>
        <ui:Button name="logs-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Logs &amp; CLI panel (Shortcut: Ctrl + `).&#10;&#10;View console output, filter by severity or regex, and execute debug commands."/>
        <ui:Button name="hierarchy-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Hierarchy panel.&#10;&#10;Explore scene objects, two-way sync with Unity Editor Selection, pick objects in Game View, and search by name or component type."/>
        <ui:Button name="inspector-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Inspector panel.&#10;&#10;Inspect runtime fields and properties of selected GameObjects, toggle component states, and auto-pause gameplay on selection."/>
        <ui:Button name="metrics-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Performance panel.&#10;&#10;Real-time graphs for frame time, CPU/GPU, FPS, memory, draw calls, triangles, and battery drain.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Available modifications via &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.PerformanceGraphsApi&lt;/color&gt;&lt;/b&gt;:&#10;• &lt;b&gt;&lt;color=#ffc800&gt;SetSettings&lt;T&gt;()&lt;/color&gt;&lt;/b&gt;: Configure threshold lines, default expanded state, tooltips, or disable/hide graphs.&#10;• &lt;b&gt;&lt;color=#ffc800&gt;TicksCapacity&lt;/color&gt;&lt;/b&gt;: Adjust graph history buffer capacity.&#10;• &lt;b&gt;&lt;color=#ffc800&gt;Register()&lt;/color&gt;&lt;/b&gt;: Add custom graphs (inherit &lt;b&gt;&lt;color=#ffc800&gt;BaseGraphDataProvider&lt;/color&gt;&lt;/b&gt;).&#10;• &lt;b&gt;&lt;color=#ffc800&gt;SetCollapsed()&lt;/color&gt;&lt;/b&gt;: Expand or collapse graphs programmatically."/>
        <ui:Button name="commands-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Commands panel.&#10;&#10;Execute actions, tweak runtime fields, and interact with parameterized debug tools organized into categories and groups.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Use &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.AttributesParserApi&lt;/color&gt;&lt;/b&gt; to register attribute-decorated code:&#10;• Mark methods, fields, and properties with &lt;b&gt;&lt;color=#ffc800&gt;[CommandCategory]&lt;/color&gt;&lt;/b&gt;, &lt;b&gt;&lt;color=#ffc800&gt;[CommandGroup]&lt;/color&gt;&lt;/b&gt;, &lt;b&gt;&lt;color=#ffc800&gt;[CommandButton]&lt;/color&gt;&lt;/b&gt;, and &lt;b&gt;&lt;color=#ffc800&gt;[CommandValue]&lt;/color&gt;&lt;/b&gt;.&#10;• Call &lt;b&gt;&lt;color=#ffc800&gt;RegisterStatic()&lt;/color&gt;&lt;/b&gt; (assemblies/types) or &lt;b&gt;&lt;color=#ffc800&gt;RegisterInstance()&lt;/color&gt;&lt;/b&gt; (MonoBehaviours).&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Use &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.CommandsApi&lt;/color&gt;&lt;/b&gt; for advanced manual runtime registration:&#10;• &lt;b&gt;&lt;color=#ffc800&gt;AddCategory()&lt;/color&gt;&lt;/b&gt; / &lt;b&gt;&lt;color=#ffc800&gt;RemoveCategory()&lt;/color&gt;&lt;/b&gt;: Manage &lt;b&gt;&lt;color=#ffc800&gt;CommandCategory&lt;/color&gt;&lt;/b&gt;&#10;• &lt;b&gt;&lt;color=#ffc800&gt;AddGroup()&lt;/color&gt;&lt;/b&gt; / &lt;b&gt;&lt;color=#ffc800&gt;RemoveGroup()&lt;/color&gt;&lt;/b&gt;: Manage &lt;b&gt;&lt;color=#ffc800&gt;CommandGroup&lt;/color&gt;&lt;/b&gt;&#10;• &lt;b&gt;&lt;color=#ffc800&gt;AddCommand()&lt;/color&gt;&lt;/b&gt; / &lt;b&gt;&lt;color=#ffc800&gt;RemoveCommand()&lt;/color&gt;&lt;/b&gt;: Manage &lt;b&gt;&lt;color=#ffc800&gt;Command&lt;/color&gt;&lt;/b&gt; rows&#10;• &lt;b&gt;&lt;color=#ffc800&gt;AttachCommandUnit()&lt;/color&gt;&lt;/b&gt;: Attach buttons (&lt;b&gt;&lt;color=#ffc800&gt;CommandUnitButton&lt;/color&gt;&lt;/b&gt;) or values (&lt;b&gt;&lt;color=#ffc800&gt;CommandUnitValue&lt;/color&gt;&lt;/b&gt;)&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Use &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Default.CommandsApi&lt;/color&gt;&lt;/b&gt; providers to extend command capabilities:&#10;• &lt;b&gt;&lt;color=#ffc800&gt;RegisterAdapter()&lt;/color&gt;&lt;/b&gt;: Custom parameter type converters (&lt;b&gt;&lt;color=#ffc800&gt;CommandValueAdapter&lt;/color&gt;&lt;/b&gt;)&#10;• &lt;b&gt;&lt;color=#ffc800&gt;RegisterValuesProvider()&lt;/color&gt;&lt;/b&gt;: Dropdown choices and parameter suggestions (&lt;b&gt;&lt;color=#ffc800&gt;CommandValuesProvider&lt;/color&gt;&lt;/b&gt;)&#10;• &lt;b&gt;&lt;color=#ffc800&gt;RegisterTargetForFunctionsProvider()&lt;/color&gt;&lt;/b&gt;: Dynamic instance targets (&lt;b&gt;&lt;color=#ffc800&gt;CommandFunctionsSourceProvider&lt;/color&gt;&lt;/b&gt;)&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Check the &lt;b&gt;&lt;color=#ffc800&gt;CommonCommands&lt;/color&gt;&lt;/b&gt; class implementation for practical examples of attributes, manual registration, and provider usage."/>
        <ui:Button name="pinned-commands-btn" text="" class="ff-control-panel-btn" tooltip="Toggle Pinned Commands panel.&#10;&#10;Quick-access bar for frequently used commands. Pin commands via the pin icon in the Commands panel.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Mark methods with &lt;b&gt;&lt;color=#ffc800&gt;[Command(AlwaysPin = true)]&lt;/color&gt;&lt;/b&gt; in code to pin permanently."/>
        <ui:Button name="expand-btn" text="" class="ff-control-panel-btn" tooltip="Expand/Collapse DevSuite.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;Configure button settings (Activation Mode, Button Expand Visibility) in the &lt;b&gt;&lt;color=#ffc800&gt;DevSuitePanel&lt;/color&gt;&lt;/b&gt; prefab Settings.&#10;&#10;&lt;b&gt;&lt;i&gt;Hint: &lt;/i&gt;&lt;/b&gt;To disable the panel, define the scripting symbol &lt;b&gt;&lt;color=#ffc800&gt;DEVSUITE_DISABLED&lt;/color&gt;&lt;/b&gt;, or set &lt;b&gt;&lt;color=#ffc800&gt;DevSuiteContext.Enabled = false&lt;/color&gt;&lt;/b&gt; before &lt;b&gt;&lt;color=#ffc800&gt;DevSuitePanelUI.Awake&lt;/color&gt;&lt;/b&gt; (order -99)."/>
    </ui:VisualElement>
</ui:UXML>
